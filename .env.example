DATABASE_URL="postgresql://postgres:postgres@localhost:5432/delegate"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_DASHBOARD_URL="http://localhost:3001"
NEXT_PUBLIC_REPRESENTATIVE_URL="http://localhost:3002"
NEXT_PUBLIC_ENABLE_PUBLIC_DEMOS="false"
# Server-only WeChat Pay API v3 Native checkout. Keep disabled until every
# credential and the public HTTPS callback are configured. Collection controls
# only new orders; processing must stay enabled for callbacks, order recovery,
# and refund handling during an emergency collection pause. The legacy flag is
# retained only as a fallback when both split flags are absent.
# Prefer the current
# WeChat Pay public-key mode (PUB_KEY_ID_*). During WeChat's gray migration,
# keep the previous platform certificate configured too so callbacks signed by
# either key continue to verify.
DELEGATE_WECHAT_PAY_ENABLED="false"
DELEGATE_WECHAT_PAY_COLLECTION_ENABLED="false"
DELEGATE_WECHAT_PAY_PROCESSING_ENABLED="false"
WECHAT_PAY_APP_ID=""
WECHAT_PAY_MERCHANT_ID=""
WECHAT_PAY_MERCHANT_CERTIFICATE_SERIAL_NUMBER=""
WECHAT_PAY_MERCHANT_PRIVATE_KEY_BASE64=""
WECHAT_PAY_API_V3_KEY=""
WECHAT_PAY_PUBLIC_KEY_ID=""
WECHAT_PAY_PUBLIC_KEY_BASE64=""
WECHAT_PAY_PLATFORM_CERTIFICATE_SERIAL_NUMBER=""
WECHAT_PAY_PLATFORM_CERTIFICATE_BASE64=""
WECHAT_PAY_VERIFICATION_KEYS_JSON=""
# Optional public HTTPS override. When blank, the server derives this from
# NEXT_PUBLIC_REPRESENTATIVE_URL plus /api/payments/wechat/notify. Production
# must therefore set NEXT_PUBLIC_REPRESENTATIVE_URL to its public HTTPS origin.
# Example override:
# https://reps.example.com/api/payments/wechat/notify
# Refund notifications use a separate callback. When blank, the server derives
# it from NEXT_PUBLIC_REPRESENTATIVE_URL plus
# /api/payments/wechat/refund-notify.
WECHAT_PAY_NOTIFY_URL=""
WECHAT_PAY_REFUND_NOTIFY_URL=""
WECHAT_PAY_ORDER_DESCRIPTION="Delegate 数字代表服务充值"
# workflow-runner only: durable pending-order query and refund-reversal Outbox
# polling. The lease must be at least 75000ms so it exceeds the provider's
# maximum 60-second request timeout with room for database lease fencing.
WECHAT_PAY_RECONCILIATION_POLL_MS="5000"
WECHAT_PAY_RECONCILIATION_BATCH_SIZE="10"
WECHAT_PAY_RECONCILIATION_LEASE_MS="75000"
WECHAT_PAY_RECONCILIATION_PENDING_BACKOFF_MS="10000"
WECHAT_PAY_RECONCILIATION_ERROR_BACKOFF_MS="5000"
WECHAT_PAY_RECONCILIATION_MAX_BACKOFF_MS="600000"
# Delegate application OIDC settings. The separate local Logto OSS stack writes
# its infrastructure credentials to .local/logto/logto.env; see
# deploy/logto/logto.env.example and docs/logto-self-hosting-runbook.md.
LOGTO_ENDPOINT=""
# Optional trusted server-to-server route used only for token and JWKS calls.
# Authorization URLs and the expected JWT issuer always use LOGTO_ENDPOINT.
LOGTO_BACKCHANNEL_ENDPOINT=""
LOGTO_SCOPES="openid profile email phone"
# Dashboard and Public Representatives are separate confidential applications.
# Callback URIs are derived only from the corresponding NEXT_PUBLIC_* origin:
#   Dashboard:              /auth/callback
#   Public Representatives: /auth/callback
LOGTO_DASHBOARD_APP_ID=""
LOGTO_DASHBOARD_APP_SECRET=""
LOGTO_REPS_APP_ID=""
LOGTO_REPS_APP_SECRET=""
# Temporary in-flight compatibility for previously issued dynamic Reps
# callbacks. Keep the complete legacy tuple only in the Reps service, set an
# RFC3339 deadline no more than the intended drain window ahead, then remove all
# legacy variables after the deadline. The legacy route returns 410 when any
# required value is absent, invalid, or expired.
LOGTO_REPS_LEGACY_ENDPOINT=""
LOGTO_REPS_LEGACY_BACKCHANNEL_ENDPOINT=""
LOGTO_REPS_LEGACY_APP_ID=""
LOGTO_REPS_LEGACY_APP_SECRET=""
DELEGATE_REPS_LEGACY_CALLBACK_UNTIL=""
LOGTO_ACCOUNT_CENTER_URL=""
# Comma/newline-separated exact Logto principals admitted to create a new
# Creator account. Each entry uses issuer|subject. Existing Owner links remain
# valid after removal. Subject-only entries and wildcards are rejected.
DELEGATE_CREATOR_ADMISSION_PRINCIPALS=""
# Keep shadow while issuer-less signed audience sessions can still be valid.
# Change to enforce only after their maximum TTL has elapsed and the issuer
# preflight reports no blockers.
DELEGATE_AUTH_IDENTITY_ISSUER_MODE="shadow"
# Finite Account/AppSession v2 rollout. legacy never touches the new tables.
# shadow keeps legacy authority while atomically issuing HttpOnly v2 cookies for
# comparison. enforce/contract fail closed until v2 read authority ships.
DELEGATE_ACCOUNT_SESSION_MODE="legacy"
DELEGATE_AUTH_SESSION_SECRET="delegate-local-auth-session-secret-change-me"
REP_PUBLIC_CHAT_SESSION_SECRET="delegate-local-public-chat-session-secret-change-me"
DELEGATE_DASHBOARD_AUTH_MODE="optional"
# Manual local-development controls. compose.local.yml explicitly enables both.
# Production code always rejects development login and the bootstrap write.
DELEGATE_AUTH_DEV_LOGIN="false"
DELEGATE_AUTH_DEV_ISSUER="https://local-auth.delegate.invalid/oidc"
# Independent write opt-in for running pnpm local:auth:bootstrap manually.
DELEGATE_LOCAL_AUTH_BOOTSTRAP="false"
DELEGATE_AUTH_DEV_OWNER_SUBJECT="delegate-dev-owner"
DELEGATE_AUTH_DEV_OWNER_EMAIL="creator@delegate.local"
DELEGATE_AUTH_DEV_AUDIENCE_SUBJECT="delegate-dev-audience"
DELEGATE_AUTH_DEV_AUDIENCE_EMAIL="audience@delegate.local"
TELEGRAM_BOT_TOKEN=""
# Required for Dashboard-managed channel credentials. Generate a unique key
# with `openssl rand -base64 32`; never reuse the example across deployments.
CHANNEL_CREDENTIAL_MASTER_KEY=""
# Changing the key/version requires re-entering every stored Bot token.
CHANNEL_CREDENTIAL_MASTER_KEY_VERSION="v1"
# Required before storing a tokenized Creator payout destination. Generate a
# separate 32-byte key; never reuse the channel credential key.
PAYOUT_CREDENTIAL_MASTER_KEY=""
PAYOUT_CREDENTIAL_MASTER_KEY_VERSION="v1"
# Optional cold-start hint for Web binding; the Bot validates and persists it after getMe.
TELEGRAM_BOT_ID=""
TELEGRAM_BOT_USERNAME=""
TELEGRAM_WEBHOOK_SECRET=""
# Optional Bot-only public HTTPS origin for clickable Web recharge buttons.
# Keep the representative app's own canonical origin independent.
TELEGRAM_WEB_RECHARGE_BASE_URL=""
# legacy = current grammY runtime; shadow = dual-write only; worker = shared Conversation Platform replies
TELEGRAM_CONVERSATION_PLATFORM_MODE="worker"
TELEGRAM_STARS_LIVE_ENABLED="false"
# Telegram has no client idempotency key for sendMessage; timeout retries are at-least-once.
TELEGRAM_REQUEST_TIMEOUT_MS="15000"
# Multi-replica polling ownership. Defaults keep one full 60-second Telegram
# request window between a failed heartbeat and database lease expiry.
TELEGRAM_RUNTIME_RECONCILE_MS="5000"
TELEGRAM_RUNTIME_LEASE_MS="120000"
TELEGRAM_RUNTIME_LEASE_RENEW_MS="20000"
TELEGRAM_RUNTIME_LEASE_DB_TIMEOUT_MS="10000"
# Enforced minimum: 5 minutes. Active generation workers renew this lease.
CONVERSATION_OUTBOX_PROCESSING_LEASE_MS="300000"
DEMO_REP_SLUG="lin-founder-rep"
