# Documentation template for the generated local file:
#   .local/logto/logto.env
#
# Run `pnpm logto:local:bootstrap`; do not copy these placeholder secrets into
# production. The local wrapper accepts only loopback endpoints and this exact
# Logto release.
LOGTO_OSS_IMAGE=svhd/logto:1.41.0
LOGTO_OSS_POSTGRES_IMAGE=postgres:17-alpine
LOGTO_OSS_ENDPOINT=http://127.0.0.1:3301
LOGTO_OSS_ADMIN_ENDPOINT=http://127.0.0.1:3302
LOGTO_OSS_CORE_PORT=3301
LOGTO_OSS_ADMIN_PORT=3302
LOGTO_OSS_DB_NAME=logto
LOGTO_OSS_DB_USER=logto
LOGTO_OSS_DB_PASSWORD=replace-with-at-least-24-alphanumeric-characters
LOGTO_OSS_SECRET_VAULT_KEK=replace-with-base64-encoded-32-byte-key
LOGTO_OSS_DATABASE_STATEMENT_TIMEOUT=30000
LOGTO_OSS_PRIVATE_KEY_ROTATION_GRACE_PERIOD=0
