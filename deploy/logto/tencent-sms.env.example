# Copy to .local/logto/tencent-sms.env (ignored by Git); chmod 600 that file.
# Read by scripts/logto-phone-auth.mjs. Never put real credentials in this template.
TENCENT_SMS_SECRET_ID=
TENCENT_SMS_SECRET_KEY=
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
# Approved domestic SMS template with one {1} code placeholder.
TENCENT_SMS_TEMPLATE_ID=
TENCENT_SMS_REGION=ap-guangzhou
# Optional: your own +86 mobile, used only by the explicit --test-sms command.
TENCENT_SMS_TEST_PHONE=
