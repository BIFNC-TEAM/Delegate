# Copy to .local/logto/wechat.env, chmod 600. Never commit actual credentials.
# Website application credentials from WeChat Open Platform (not a mini program).
WECHAT_WEB_APP_ID=
WECHAT_WEB_APP_SECRET=
# Required when enabling a non-loopback Logto instance. Hostname only, no scheme/path.
# Must match the authorized callback domain configured in WeChat Open Platform
# AND the public LOGTO_ENDPOINT of the target environment.
WECHAT_WEB_CALLBACK_DOMAIN=
