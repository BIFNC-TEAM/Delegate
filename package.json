{
  "name": "delegate",
  "private": true,
  "engines": {
    "node": ">=20.18.1"
  },
  "packageManager": "pnpm@10.23.0",
  "scripts": {
    "build": "turbo run build",
    "verify": "pnpm db:generate && pnpm db:validate && pnpm typecheck && pnpm test",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "dev:web": "pnpm --filter @delegate/dashboard dev",
    "dev:site": "pnpm --filter @delegate/site dev",
    "dev:dashboard": "pnpm --filter @delegate/dashboard dev",
    "dev:reps": "pnpm --filter @delegate/reps dev",
    "dev:bot": "pnpm --filter @delegate/bot dev",
    "dev:compute-broker": "pnpm --filter @delegate/compute-broker dev",
    "dev:workflow-runner": "pnpm --filter @delegate/workflow-runner dev",
    "dev:matrix-bridge": "pnpm --filter @delegate/matrix-bridge dev",
    "dev:conversation-worker": "pnpm --filter @delegate/conversation-worker dev",
    "registry:search:clawhub": "tsx scripts/clawhub-search.ts",
    "docker:up": "docker compose up -d --build",
    "docker:up:local": "docker compose -f compose.yml -f compose.local.yml up -d --build",
    "docker:up:matrix": "bash deploy/matrix/compose.sh up -d --build",
    "docker:up:temporal": "WORKFLOW_ENGINE=temporal WORKFLOW_TEMPORAL_ADDRESS=temporal:7233 WORKFLOW_TEMPORAL_NAMESPACE=delegate WORKFLOW_TEMPORAL_TASK_QUEUE=delegate-public-runtime docker compose --profile temporal up -d --build temporal-db-init temporal temporal-ui temporal-namespace-init workflow-runner",
    "docker:up:db": "docker compose up -d postgres",
    "docker:down": "bash deploy/matrix/down.sh all",
    "docker:logs": "docker compose logs -f",
    "docker:ps": "docker compose ps",
    "logto:local:bootstrap": "bash deploy/logto/bootstrap.sh",
    "logto:local:config": "bash deploy/logto/compose.sh config",
    "logto:local:preflight": "bash deploy/logto/preflight.sh",
    "logto:local:init": "bash deploy/logto/init.sh",
    "logto:local:up": "bash deploy/logto/up.sh",
    "logto:local:backup": "bash deploy/logto/backup.sh",
    "logto:local:verify-backup": "bash deploy/logto/verify-backup.sh",
    "logto:local:alter": "bash deploy/logto/alter.sh",
    "logto:local:smoke": "bash deploy/logto/smoke.sh",
    "logto:local:ps": "bash deploy/logto/compose.sh ps",
    "logto:local:logs": "bash deploy/logto/compose.sh logs -f logto",
    "logto:local:down": "bash deploy/logto/compose.sh down",
    "test:logto:config": "vitest run scripts/tests/logto-compose-contract.test.ts",
    "test:logto:identity-contracts": "vitest run scripts/tests/logto-issuer-safe-migration.test.ts scripts/tests/logto-account-identity-preflight.test.ts",
    "matrix:local:init": "bash deploy/matrix/bootstrap.sh",
    "matrix:local:up": "bash deploy/matrix/up-e2e.sh",
    "matrix:local:smoke": "MATRIX_LOCAL_SMOKE_START_STACK=false bash scripts/tests/matrix-synapse-smoke.sh",
    "matrix:local:e2e": "bash scripts/tests/matrix-synapse-smoke.sh",
    "matrix:local:logs": "bash deploy/matrix/inspect.sh logs",
    "matrix:local:ps": "bash deploy/matrix/inspect.sh ps",
    "matrix:local:down": "bash deploy/matrix/down.sh matrix",
    "matrix:local:reset-e2e-db": "bash deploy/matrix/reset-e2e-db.sh",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:validate": "prisma validate --schema prisma/schema.prisma",
    "db:migrate:dev": "prisma migrate dev --schema prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "pnpm db:generate && pnpm db:deploy && pnpm db:seed",
    "wallet:reconcile": "node --import tsx scripts/wallet-reconcile.ts",
    "test:wallet-reconcile-cli": "vitest run scripts/tests/wallet-reconcile-cli.test.ts",
    "auth:identity:preflight": "bash scripts/logto-account-identity-preflight.sh",
    "local:auth:bootstrap": "tsx scripts/local-auth-bootstrap.ts",
    "test:channels": "bash scripts/tests/channels-offline.sh",
    "test:channels:pg16": "pnpm test:channels && pnpm test:postgres:seed && pnpm test:postgres:channel-platform && pnpm test:postgres:entitlements && pnpm test:postgres:channel-migration && pnpm test:postgres:matrix-assignment-revision",
    "test:postgres:seed": "bash scripts/tests/prisma-seed.pg16.sh",
    "test:postgres:channel-platform": "bash scripts/tests/channel-platform.pg16.sh",
    "test:postgres:entitlements": "bash scripts/tests/service-entitlements-concurrency.pg16.sh",
    "test:postgres:owner-settings": "bash scripts/tests/owner-settings.pg16.sh",
    "test:postgres:telegram-lease": "bash scripts/tests/telegram-runtime-lease.pg16.sh",
    "test:postgres:wallet": "bash scripts/tests/wallet-concurrency.pg16.sh",
    "test:postgres:skills": "pnpm --filter @delegate/web-data test:postgres:skills",
    "test:postgres:mcp-health": "pnpm --filter @delegate/compute-broker test:postgres:mcp-health",
    "test:postgres:channel-migration": "bash scripts/tests/channel-identity-entitlements-migration.pg16.sh",
    "test:postgres:matrix-assignment-revision": "bash scripts/tests/matrix-assignment-revision-migration.pg16.sh",
    "test:postgres:logto-issuer-safe": "bash scripts/tests/logto-issuer-safe-migration.pg16.sh",
    "test:postgres:account-appsession-shadow": "bash scripts/tests/account-appsession-shadow.pg16.sh",
    "test:migration-gate": "vitest run scripts/tests/workspace-skill-release-gate.test.ts",
    "test:migration-fixture:pg16": "bash scripts/tests/workspace-skill-legacy-migration.pg16.sh",
    "test:wallet-migration-fixture:pg16": "bash scripts/tests/wallet-scoped-migration.pg16.sh"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "prisma": "^6.19.2",
    "tsx": "^4.21.0",
    "turbo": "^2.8.20",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "@prisma/client": "^6.19.2"
  },
  "pnpm": {
    "overrides": {
      "@opentelemetry/propagator-jaeger": "2.10.0",
      "defu": "6.1.7",
      "effect": "3.22.0",
      "postcss": "8.5.21"
    }
  }
}
