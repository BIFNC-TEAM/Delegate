{
  "name": "@delegate/web-data",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./compute-conversation-results": "./src/compute-conversation-results.ts",
    "./owner-settings": "./src/owner-settings.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:postgres:entitlements": "DELEGATE_POSTGRES_E2E=1 vitest run tests/postgres-service-entitlements.integration.test.ts",
    "test:postgres:owner-settings": "DELEGATE_POSTGRES_E2E=1 vitest run --no-file-parallelism tests/postgres-owner-settings.integration.test.ts",
    "test:postgres:wallet": "DELEGATE_POSTGRES_E2E=1 vitest run --no-file-parallelism tests/postgres-wallet-concurrency.integration.test.ts tests/postgres-wallet-business-closure.integration.test.ts tests/postgres-wechat-operations.integration.test.ts",
    "test:postgres:telegram-lease": "DELEGATE_TELEGRAM_LEASE_POSTGRES_E2E=1 vitest run tests/postgres-telegram-runtime-lease.integration.test.ts",
    "test:postgres:skills": "DELEGATE_POSTGRES_E2E=1 vitest run tests/postgres-skill-concurrency.integration.test.ts tests/postgres-skill-trust.integration.test.ts tests/postgres-runtime-release-pin.integration.test.ts tests/postgres-workspace-audit.integration.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1092.0",
    "@delegate/artifacts": "workspace:*",
    "@delegate/compute-protocol": "workspace:*",
    "@delegate/domain": "workspace:*",
    "@delegate/openviking": "workspace:*",
    "@delegate/registry": "workspace:*",
    "@delegate/runtime": "workspace:*",
    "@delegate/workflows": "workspace:*",
    "@prisma/client": "^6.19.2",
    "jose": "^6.2.3",
    "jszip": "^3.10.1",
    "pdf-parse": "^2.4.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "vitest": "^4.1.0"
  }
}
