model Message {
  id                                 String                              @id @default(cuid())
  conversationId                     String
  episodeId                          String?
  channelBindingId                   String?
  /// Immutable, server-resolved identity provenance captured at ingress.
  /// Shared Contact Memory fails closed for legacy rows without this evidence.
  sourceIdentityLinkId               String?
  /// Exact private-channel connection proof used at ingress. Web messages use
  /// the verified LOGTO link above and intentionally leave this field NULL.
  sourceIdentityConnectionProofId    String?
  senderType                         MessageSenderType
  senderId                           String?
  senderDisplayName                  String?
  contentType                        MessageContentType                  @default(TEXT)
  text                               String?
  content                            Json?
  clientMessageId                    String?
  externalMessageId                  String?
  replyToMessageId                   String?
  threadRootMessageId                String?
  delegationTaskId                   String?
  deliveryStatus                     MessageDeliveryStatus               @default(ACCEPTED)
  failureCode                        String?
  failureReason                      String?
  editedAt                           DateTime?
  redactedAt                         DateTime?
  redactionReason                    String?
  retentionExpiresAt                 DateTime?
  /// Server-assigned, per-conversation receive order for private-channel
  /// audience messages. Provider timestamps remain display-only and must not
  /// participate in memory disclosure authorization.
  ingressSequence                    Int?
  /// Snapshot of the representative channel lifecycle that admitted this
  /// private-channel message. Legacy NULL rows fail closed when used as a
  /// source for new asynchronous channel work.
  channelLifecycleRevision           Int?
  /// Monotonic Telegram edit watermark. Both fields are claimed atomically
  /// with the message edit so delayed/retried provider updates cannot replace
  /// a newer edit.
  telegramLastEditAt                 DateTime?
  telegramLastEditUpdateId           BigInt?
  /// Server-assigned global receive order for audience messages. Unlike
  /// provider timestamps, this safely fences memory work across conversations.
  memoryIngressOrdinal               BigInt?
  createdAt                          DateTime                            @default(now())
  updatedAt                          DateTime                            @updatedAt
  conversation                       Conversation                        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  episode                            ConversationEpisode?                @relation(fields: [episodeId], references: [id], onDelete: SetNull)
  channelBinding                     ConversationChannelBinding?         @relation(fields: [channelBindingId], references: [id], onDelete: SetNull)
  sourceIdentityLink                 IdentityLink?                       @relation("MessageSourceIdentityLink", fields: [sourceIdentityLinkId], references: [id], onDelete: Restrict)
  sourceIdentityConnectionProof      IdentityLinkConnectionProof?        @relation("MessageSourceIdentityConnectionProof", fields: [sourceIdentityConnectionProofId], references: [id], onDelete: Restrict)
  replyTo                            Message?                            @relation("MessageReplies", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies                            Message[]                           @relation("MessageReplies")
  threadRoot                         Message?                            @relation("MessageThreads", fields: [threadRootMessageId], references: [id], onDelete: SetNull)
  threadMessages                     Message[]                           @relation("MessageThreads")
  delegationTask                     DelegationTask?                     @relation(fields: [delegationTaskId], references: [id], onDelete: SetNull)
  revisions                          MessageRevision[]
  attachments                        MessageAttachment[]
  citations                          MessageCitation[]
  inputForGenerationRuns             GenerationRun[]                     @relation("GenerationInputMessage")
  outputForGenerationRuns            GenerationRun[]                     @relation("GenerationOutputMessage")
  memoryCandidates                   MemoryCandidate[]
  memoryExtractionRuns               MemoryExtractionRun[]
  memoryUseRunInputs                 MemoryUseRun[]                      @relation("MemoryUseInputMessage")
  memoryUseRunOutputs                MemoryUseRun[]                      @relation("MemoryUseOutputMessage")
  memoryDisclosureActivationBoundary MemoryChannelDisclosureActivation?  @relation("MemoryDisclosureActivationBoundary")
  memoryForgetBoundary               ContactChannelMemoryForgetBoundary? @relation("ContactChannelMemoryForgetSourceMessage")

  @@unique([conversationId, clientMessageId])
  @@unique([channelBindingId, externalMessageId])
  @@unique([id, conversationId])
  @@unique([conversationId, ingressSequence], map: "Message_conversation_ingress_sequence_key")
  @@unique([memoryIngressOrdinal], map: "Message_memory_ingress_ordinal_key")
  @@index([conversationId, createdAt])
  @@index([conversationId, deliveryStatus, createdAt])
  @@index([episodeId, createdAt])
  @@index([sourceIdentityLinkId])
  @@index([sourceIdentityConnectionProofId])
  @@index([delegationTaskId, createdAt])
  @@index([retentionExpiresAt])
}

