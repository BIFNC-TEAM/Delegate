  sourceKind            DeliverableSourceKind
  externalUrl           String?
  bundleItemArtifactIds String[]               @default([])
  packageObjectKey      String?
  packageMimeType       String?
  packageSizeBytes      Int?
  packageSha256         String?
  packageBuiltAt        DateTime?
  packageCacheKey       String?
  downloadCount         Int                    @default(0)
  lastDownloadedAt      DateTime?
  createdBy             String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  representative        Representative         @relation(fields: [representativeId], references: [id])
  artifact              Artifact?              @relation(fields: [artifactId], references: [id])
  delegationTask        DelegationTask?        @relation(fields: [delegationTaskId], references: [id], onDelete: SetNull)
  delegationOutputs     DelegationTaskOutput[]

  @@index([representativeId, visibility, createdAt])
  @@index([artifactId])
  @@index([representativeId, sourceKind, packageBuiltAt])
  @@index([delegationTaskId, createdAt])
}

model DelegationTask {
  id                      String                         @id @default(cuid())
  representativeId        String
  representativeVersionId String?
  contactId               String?
  audienceIdentityId      String?
  originConversationId    String?
  originEpisodeId         String?
  kind                    DelegationTaskKind             @default(SERVICE_REQUEST)
  initiatorType           DelegationTaskInitiatorType
  initiatorId             String?
  title                   String
  objective               String
  desiredOutcome          String
  status                  DelegationTaskStatus           @default(DRAFT)
  nextActionBy            DelegationTaskNextActor        @default(SYSTEM)
  blockingReason          String?
  priority                Int                            @default(0)
  idempotencyKey          String?                        @unique
  planSummary             String?
  acceptanceCriteria      Json?
  contextSnapshot         Json?
  deadlineAt              DateTime?
  startedAt               DateTime?
  completedAt             DateTime?
  failedAt                DateTime?
  canceledAt              DateTime?
  version                 Int                            @default(1)
  createdAt               DateTime                       @default(now())
  updatedAt               DateTime                       @updatedAt
  representative          Representative                 @relation(fields: [representativeId], references: [id])
  representativeVersion   RepresentativeVersion?         @relation(fields: [representativeVersionId], references: [id], onDelete: SetNull)
  contact                 Contact?                       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  audienceIdentity        AudienceIdentity?              @relation(fields: [audienceIdentityId], references: [id], onDelete: SetNull)
  originConversation      Conversation?                  @relation(fields: [originConversationId], references: [id], onDelete: SetNull)
  originEpisode           ConversationEpisode?           @relation(fields: [originEpisodeId], references: [id], onDelete: SetNull)
  messages                Message[]
  generationRuns          GenerationRun[]
  computeSessions         ComputeSession[]
  toolExecutions          ToolExecution[]
  approvalRequests        ApprovalRequest[]
  workflowRuns            WorkflowRun[]
  artifacts               Artifact[]
  deliverables            Deliverable[]
  ledgerEntries           LedgerEntry[]
  auditEvents             EventAudit[]
  inputs                  DelegationTaskInput[]
  dataGrants              DelegationTaskDataGrant[]
  resourcePolicy          DelegationTaskResourcePolicy?
  steps                   DelegationTaskStep[]
  externalEffects         DelegationTaskExternalEffect[]
  outputs                 DelegationTaskOutput[]
  events                  DelegationTaskEvent[]

  @@index([representativeId, status, updatedAt])
  @@index([contactId, status, updatedAt])
  @@index([audienceIdentityId, status, updatedAt])
  @@index([originConversationId, createdAt])
  @@index([nextActionBy, status, updatedAt])
  @@index([deadlineAt, status])
}

model DelegationTaskInput {
  id                    String                    @id @default(cuid())
  delegationTaskId      String
  kind                  DelegationTaskInputKind
  referenceType         String
  referenceId           String?
