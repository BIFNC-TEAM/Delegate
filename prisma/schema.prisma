  platformRevenueCents Int                        @default(0)
  currency             String                     @default("CNY")
  idempotencyKey       String                     @unique
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  reservedAt           DateTime?
  settledAt            DateTime?
  releasedAt           DateTime?
  reversedAt           DateTime?
  userAgentWallet      UserAgentWallet?           @relation(fields: [userAgentWalletId], references: [id], onDelete: Restrict)
  agentWallet          AgentWallet                @relation(fields: [agentWalletId], references: [id])
  representative       Representative             @relation(fields: [representativeId], references: [id])
  audienceIdentity     AudienceIdentity?          @relation(fields: [audienceIdentityId], references: [id], onDelete: Restrict)
  entitlementAccount   ServiceEntitlementAccount? @relation(fields: [entitlementAccountId], references: [id], onDelete: Restrict)
  conversation         Conversation?              @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  generationRun        GenerationRun?             @relation(fields: [generationRunId], references: [id], onDelete: Restrict)
  tokenPurchase        AgentTokenPurchase?        @relation(fields: [tokenPurchaseId], references: [id])
  creatorEarnings      CreatorEarning[]
  allocations          AgentUsageAllocation[]
  ledgerEntries        WalletLedgerEntry[]

  @@index([userAgentWalletId, status, createdAt])
  @@index([agentWalletId, status, createdAt])
  @@index([representativeId, kind, createdAt])
  @@index([audienceIdentityId, representativeId, createdAt])
  @@index([entitlementAccountId, status, createdAt])
  @@index([conversationId, createdAt])
  @@index([generationRunId])
}

