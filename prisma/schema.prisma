  label                 String
  mimeType              String?
  sha256                String?
  providedByType        DelegationTaskActorType
  providedById          String?
  authorizationRequired Boolean                   @default(false)
  metadata              Json?
  createdAt             DateTime                  @default(now())
  delegationTask        DelegationTask            @relation(fields: [delegationTaskId], references: [id], onDelete: Cascade)
  dataGrants            DelegationTaskDataGrant[]

  @@index([delegationTaskId, createdAt])
  @@index([referenceType, referenceId])
}

model DelegationTaskDataGrant {
  id               String                    @id @default(cuid())
  delegationTaskId String
  taskInputId      String?
  grantorType      DelegationTaskActorType
  grantorId        String?
  resourceType     String
  resourceId       String
  scopes           String[]                  @default([])
  purpose          String
  status           DelegationDataGrantStatus @default(ACTIVE)
  policySnapshot   Json?
  grantedAt        DateTime                  @default(now())
  expiresAt        DateTime?
  revokedAt        DateTime?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  delegationTask   DelegationTask            @relation(fields: [delegationTaskId], references: [id], onDelete: Cascade)
  taskInput        DelegationTaskInput?      @relation(fields: [taskInputId], references: [id], onDelete: SetNull)

  @@index([delegationTaskId, status, createdAt])
  @@index([resourceType, resourceId, status])
  @@index([taskInputId])
}

model DelegationTaskResourcePolicy {
  id                                    String                @id @default(cuid())
  delegationTaskId                      String                @unique
  maxDurationMinutes                    Int                   @default(15)
  maxCostCents                          Int?
  maxCredits                            Int?
  maxComputeMinutes                     Int?
  maxToolCalls                          Int                   @default(1)
  maxSteps                              Int                   @default(1)
  maxArtifactBytes                      Int?
  allowedCapabilities                   CapabilityKind[]      @default([])
  allowedSkillSlugs                     String[]              @default([])
  allowedMcpBindingIds                  String[]              @default([])
  allowedExternalAccountIds             String[]              @default([])
  networkMode                           ComputeNetworkMode    @default(NO_NETWORK)
  filesystemMode                        ComputeFilesystemMode @default(WORKSPACE_ONLY)
  requireApprovalForExternalSideEffects Boolean               @default(true)
  snapshot                              Json?
  createdAt                             DateTime              @default(now())
  updatedAt                             DateTime              @updatedAt
  delegationTask                        DelegationTask        @relation(fields: [delegationTaskId], references: [id], onDelete: Cascade)
}

model DelegationTaskStep {
  id                 String                         @id @default(cuid())
  delegationTaskId   String
  sequence           Int
  kind               DelegationTaskStepKind
  title              String
  description        String?
  status             DelegationTaskStepStatus       @default(DRAFT)
  capability         CapabilityKind?
  skillSlug          String?
  mcpBindingId       String?
  externalAccountId  String?
  dependsOnStepIds   String[]                       @default([])
  requiresApproval   Boolean                        @default(false)
  approvedAt         DateTime?
  maxCostCents       Int?
  maxDurationSeconds Int?
  inputSnapshot      Json?
  outputSnapshot     Json?
  idempotencyKey     String?                        @unique
  startedAt          DateTime?
  completedAt        DateTime?
  failedAt           DateTime?
  createdAt          DateTime                       @default(now())
  updatedAt          DateTime                       @updatedAt
  delegationTask     DelegationTask                 @relation(fields: [delegationTaskId], references: [id], onDelete: Cascade)
  generationRuns     GenerationRun[]
  computeSessions    ComputeSession[]
  toolExecutions     ToolExecution[]
  approvalRequests   ApprovalRequest[]
  workflowRuns       WorkflowRun[]
  artifacts          Artifact[]
  externalEffects    DelegationTaskExternalEffect[]
  outputs            DelegationTaskOutput[]

  @@unique([delegationTaskId, sequence])
  @@index([delegationTaskId, status, sequence])
}

model DelegationTaskExternalEffect {
  id                   String                         @id @default(cuid())
  delegationTaskId     String
  delegationTaskStepId String?
  approvalRequestId    String?                        @unique
  type                 String
  target               String
  action               String
  status               DelegationExternalEffectStatus @default(PROPOSED)
  idempotencyKey       String                         @unique
  requestPayload       Json?
  responseSnapshot     Json?
  externalReferenceId  String?
  approvedAt           DateTime?
  executedAt           DateTime?
  reconciledAt         DateTime?
  failureReason        String?
  createdAt            DateTime                       @default(now())
  updatedAt            DateTime                       @updatedAt
  delegationTask       DelegationTask                 @relation(fields: [delegationTaskId], references: [id], onDelete: Cascade)
  delegationTaskStep   DelegationTaskStep?            @relation(fields: [delegationTaskStepId], references: [id], onDelete: SetNull)
  approvalRequest      ApprovalRequest?               @relation(fields: [approvalRequestId], references: [id], onDelete: SetNull)
  output               DelegationTaskOutput?

  @@index([delegationTaskId, status, createdAt])
  @@index([delegationTaskStepId])
  @@index([externalReferenceId])
}

model DelegationTaskOutput {
  id                   String                        @id @default(cuid())
  delegationTaskId     String
  delegationTaskStepId String?
  kind                 DelegationTaskOutputKind
  artifactId           String?
  deliverableId        String?
  externalEffectId     String?                       @unique
  title                String
  summary              String?
  isFinal              Boolean                       @default(false)
  createdAt            DateTime                      @default(now())
  delegationTask       DelegationTask                @relation(fields: [delegationTaskId], references: [id], onDelete: Cascade)
  delegationTaskStep   DelegationTaskStep?           @relation(fields: [delegationTaskStepId], references: [id], onDelete: SetNull)
  artifact             Artifact?                     @relation(fields: [artifactId], references: [id], onDelete: SetNull)
  deliverable          Deliverable?                  @relation(fields: [deliverableId], references: [id], onDelete: SetNull)
  externalEffect       DelegationTaskExternalEffect? @relation(fields: [externalEffectId], references: [id], onDelete: SetNull)

  @@index([delegationTaskId, isFinal, createdAt])
  @@index([delegationTaskStepId])
  @@index([artifactId])
  @@index([deliverableId])
}

model DelegationTaskEvent {
  id               String                  @id @default(cuid())
  delegationTaskId String
  sequence         Int
  eventType        String
  actorType        DelegationTaskActorType
  actorId          String?
  fromStatus       DelegationTaskStatus?
  toStatus         DelegationTaskStatus?
  payload          Json?
  previousHash     String?
  eventHash        String
  occurredAt       DateTime                @default(now())
  delegationTask   DelegationTask          @relation(fields: [delegationTaskId], references: [id], onDelete: Cascade)

  @@unique([delegationTaskId, sequence])
  @@index([delegationTaskId, occurredAt])
  @@index([eventType, occurredAt])
}

model WorkflowRun {
  id                   String                  @id @default(cuid())
  representativeId     String
  contactId            String?
  conversationId       String?
  handoffRequestId     String?
  approvalRequestId    String?
  subagentId           String?
  delegationTaskId     String?
  delegationTaskStepId String?
  kind                 WorkflowKind
  engine               WorkflowEngine          @default(LOCAL_RUNNER)
  status               WorkflowStatus          @default(QUEUED)
  enginePhase          WorkflowEnginePhase?
  dedupeKey            String                  @unique
  queueName            String?
  externalWorkflowId   String?
  externalRunId        String?
  scheduledAt          DateTime
  nextWakeAt           DateTime?
  startedAt            DateTime?
  completedAt          DateTime?
  failedAt             DateTime?
  cancelRequestedAt    DateTime?
  lastObservedAt       DateTime?
  lastError            String?
  lastEngineError      String?
  input                Json
  output               Json?
  attemptCount         Int                     @default(0)
  dispatchAttemptCount Int                     @default(0)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  representative       Representative          @relation(fields: [representativeId], references: [id])
  contact              Contact?                @relation(fields: [contactId], references: [id])
  conversation         Conversation?           @relation(fields: [conversationId], references: [id])
  handoffRequest       HandoffRequest?         @relation(fields: [handoffRequestId], references: [id])
  approvalRequest      ApprovalRequest?        @relation(fields: [approvalRequestId], references: [id])
  delegationTask       DelegationTask?         @relation(fields: [delegationTaskId], references: [id], onDelete: SetNull)
  delegationTaskStep   DelegationTaskStep?     @relation(fields: [delegationTaskStepId], references: [id], onDelete: SetNull)
  commandOutbox        WorkflowCommandOutbox[]

  @@index([representativeId, scheduledAt])
  @@index([engine, status, scheduledAt])
  @@index([status, scheduledAt])
  @@index([handoffRequestId])
  @@index([approvalRequestId])
  @@index([delegationTaskId, status, scheduledAt])
  @@index([delegationTaskStepId])
}

model WorkflowCommandOutbox {
  id            String              @id @default(cuid())
  workflowRunId String
  commandType   WorkflowCommandType
  payload       Json?
  attemptCount  Int                 @default(0)
  availableAt   DateTime            @default(now())
  processedAt   DateTime?
  lastError     String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  workflowRun   WorkflowRun         @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)

  @@index([processedAt, availableAt, createdAt])
  @@index([workflowRunId, commandType, processedAt])
}

