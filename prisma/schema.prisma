  issueCount       Int                          @default(0)
  resolvedCount    Int                          @default(0)
  cursor           String?
  attemptCount     Int                          @default(0)
  availableAt      DateTime                     @default(now())
  leaseToken       String?
  leaseExpiresAt   DateTime?
  startedAt        DateTime?
  finishedAt       DateTime?
  errorCode        String?
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt
  representative   Representative               @relation(fields: [representativeId], references: [id], onDelete: Cascade, map: "MemoryReconciliationRun_rep_fkey")
  items            MemoryReconciliationItem[]
  targets          MemoryReconciliationTarget[]

  @@unique([representativeId, idempotencyKey], map: "MemoryReconciliationRun_rep_idempotency_key")
  @@unique([id, representativeId], map: "MemoryReconciliationRun_id_rep_key")
  @@index([representativeId, createdAt], map: "MemoryReconciliationRun_rep_created_idx")
  @@index([status, availableAt, leaseExpiresAt], map: "MemoryReconciliationRun_due_lease_idx")
}

model MemoryReconciliationTarget {
  reconciliationRunId         String
  representativeId            String
  projectionItemId            String
  kind                        MemoryReconciliationTargetKind
  status                      MemoryReconciliationTargetStatus @default(PENDING)
  snapshotProjectionStatus    MemoryProjectionStatus
  snapshotProjectionUpdatedAt DateTime
  snapshotAttemptCount        Int
  snapshotRemoteUri           String
  expectedContentHash         String
  remoteExists                Boolean?
  observedContentHash         String?
  checkedAt                   DateTime?
  attemptCount                Int                              @default(0)
  availableAt                 DateTime                         @default(now())
  leaseToken                  String?
  leaseExpiresAt              DateTime?
  lastErrorCode               String?
  createdAt                   DateTime                         @default(now())
  updatedAt                   DateTime                         @updatedAt
  reconciliationRun           MemoryReconciliationRun          @relation(fields: [reconciliationRunId, representativeId], references: [id, representativeId], onDelete: Cascade, map: "MemoryReconciliationTarget_run_scope_fkey")
  representative              Representative                   @relation(fields: [representativeId], references: [id], onDelete: Cascade, map: "MemoryReconciliationTarget_rep_fkey")
  projectionItem              MemoryProjectionItem             @relation(fields: [projectionItemId, representativeId], references: [id, representativeId], onDelete: Restrict, map: "MemoryReconciliationTarget_projection_scope_fkey")

  @@id([reconciliationRunId, projectionItemId])
  @@index([reconciliationRunId, status, availableAt, projectionItemId], map: "MemoryReconciliationTarget_run_due_idx")
  @@index([status, leaseExpiresAt], map: "MemoryReconciliationTarget_lease_idx")
  @@index([projectionItemId], map: "MemoryReconciliationTarget_projection_idx")
}

model MemoryReconciliationItem {
  id                  String                         @id @default(cuid())
  reconciliationRunId String
  representativeId    String
  projectionItemId    String?
  itemKey             String
  issueKind           MemoryReconciliationIssueKind
  status              MemoryReconciliationItemStatus @default(OPEN)
  expectedContentHash String?
  observedContentHash String?
  remoteObjectIdHash  String?
  reasonCode          String?
  attemptCount        Int                            @default(0)
  availableAt         DateTime                       @default(now())
  resolvedAt          DateTime?
  lastErrorCode       String?
  createdAt           DateTime                       @default(now())
  updatedAt           DateTime                       @updatedAt
  reconciliationRun   MemoryReconciliationRun        @relation(fields: [reconciliationRunId, representativeId], references: [id, representativeId], onDelete: Cascade, map: "MemoryReconciliationItem_run_scope_fkey")
  representative      Representative                 @relation(fields: [representativeId], references: [id], onDelete: Cascade, map: "MemoryReconciliationItem_rep_fkey")
  projectionItem      MemoryProjectionItem?          @relation(fields: [projectionItemId, representativeId], references: [id, representativeId], onDelete: Restrict, map: "MemoryReconciliationItem_projection_scope_fkey")

  @@unique([reconciliationRunId, itemKey], map: "MemoryReconciliationItem_run_item_key")
  @@index([representativeId, status, createdAt], map: "MemoryReconciliationItem_rep_status_idx")
  @@index([projectionItemId], map: "MemoryReconciliationItem_projection_idx")
  @@index([status, availableAt], map: "MemoryReconciliationItem_status_available_idx")
}
