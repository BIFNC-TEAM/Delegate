  @@index([representativeId, status, requestedAt])
  @@index([generationRunId, status])
  @@index([delegationTaskId, status, requestedAt])
  @@index([delegationTaskStepId])
}

model Artifact {
  id                   String                 @id @default(cuid())
  representativeId     String
  contactId            String?
  conversationId       String?
  sessionId            String?
  toolExecutionId      String?
  delegationTaskId     String?
  delegationTaskStepId String?
  kind                 ArtifactKind
  bucket               String
  objectKey            String
  mimeType             String
  sizeBytes            Int
  sha256               String
  isPinned             Boolean                @default(false)
  pinnedAt             DateTime?
  pinnedBy             String?
  downloadCount        Int                    @default(0)
  lastDownloadedAt     DateTime?
  retentionUntil       DateTime?
  summary              String?
  createdAt            DateTime               @default(now())
  representative       Representative         @relation(fields: [representativeId], references: [id])
  contact              Contact?               @relation(fields: [contactId], references: [id])
  conversation         Conversation?          @relation(fields: [conversationId], references: [id])
  session              ComputeSession?        @relation(fields: [sessionId], references: [id])
  toolExecution        ToolExecution?         @relation(fields: [toolExecutionId], references: [id])
  delegationTask       DelegationTask?        @relation(fields: [delegationTaskId], references: [id], onDelete: SetNull)
  delegationTaskStep   DelegationTaskStep?    @relation(fields: [delegationTaskStepId], references: [id], onDelete: SetNull)
  deliverables         Deliverable[]
  delegationOutputs    DelegationTaskOutput[]

  @@index([representativeId, createdAt])
  @@index([sessionId, createdAt])
  @@index([delegationTaskId, createdAt])
  @@index([delegationTaskStepId])
}

model Deliverable {
  id                    String                 @id @default(cuid())
  representativeId      String
  artifactId            String?
  delegationTaskId      String?
  title                 String
  summary               String
  kind                  DeliverableKind
