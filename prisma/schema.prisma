model Owner {
  id                           String                     @id @default(cuid())
  accountId                    String?                    @unique
  organizationId               String?
  telegramUserId               String?                    @unique
  displayName                  String
  accountDisplayName           String?                    @db.VarChar(80)
  handle                       String?
  timezone                     String                     @default("UTC")
  preferredLocale              String?                    @db.VarChar(16)
  settingsVersion              Int                        @default(0)
  creatorVerificationStatus    CreatorVerificationStatus  @default(UNVERIFIED)
  createdAt                    DateTime                   @default(now())
  updatedAt                    DateTime                   @updatedAt
  account                      Account?                   @relation(fields: [accountId], references: [id], onDelete: SetNull)
  wallet                       Wallet?
  notificationSettings         OwnerNotificationSettings?
  organization                 Organization?              @relation(fields: [organizationId], references: [id])
  organizationMember           OrganizationMember?
  capabilityProfiles           CapabilityPolicyProfile[]
  representatives              Representative[]
  creatorEarnings              CreatorEarning[]
  withdrawRequests             WithdrawRequest[]
  walletTransactions           WalletTransaction[]
  walletLedgerEntries          WalletLedgerEntry[]
  identityLinks                OwnerIdentityLink[]
  knowledgeAssets              KnowledgeAsset[]
  matrixVirtualUsers           MatrixVirtualUserBinding[]
  workspaceSkillInstalls       WorkspaceSkillInstall[]
  rechargeRefundRequests       RechargeRefund[]
  walletExceptionCases         WalletExceptionCase[]      @relation("WalletExceptionOwner")
  claimedWalletExceptions      WalletExceptionCase[]      @relation("WalletExceptionClaimedBy")
  acknowledgedWalletExceptions WalletExceptionCase[]      @relation("WalletExceptionAcknowledgedBy")
  walletExceptionActions       WalletExceptionAction[]
  telegramBotConnections       TelegramBotConnection[]
  auditEvents                  EventAudit[]               @relation("OwnerAuditEvents")
  payoutProfile                CreatorPayoutProfile?      @relation("PayoutProfileOwner")
