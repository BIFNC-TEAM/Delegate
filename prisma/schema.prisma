model Owner {
  id                           String                     @id @default(cuid())
  organizationId               String?
  telegramUserId               String?                    @unique
  displayName                  String
  accountDisplayName           String?                    @db.VarChar(80)
  handle                       String?
  timezone                     String                     @default("UTC")
  preferredLocale              String?                    @db.VarChar(16)
  settingsVersion              Int                        @default(0)
  creatorVerificationStatus    CreatorVerificationStatus  @default(UNVERIFIED)
  createdAt                    DateTime                   @default(now())
  updatedAt                    DateTime                   @updatedAt
  wallet                       Wallet?
  notificationSettings         OwnerNotificationSettings?
  organization                 Organization?              @relation(fields: [organizationId], references: [id])
  organizationMember           OrganizationMember?
  capabilityProfiles           CapabilityPolicyProfile[]
  representatives              Representative[]
  creatorEarnings              CreatorEarning[]
  withdrawRequests             WithdrawRequest[]
  walletTransactions           WalletTransaction[]
  walletLedgerEntries          WalletLedgerEntry[]
  identityLinks                OwnerIdentityLink[]
  knowledgeAssets              KnowledgeAsset[]
  matrixVirtualUsers           MatrixVirtualUserBinding[]
  workspaceSkillInstalls       WorkspaceSkillInstall[]
  rechargeRefundRequests       RechargeRefund[]
  walletExceptionCases         WalletExceptionCase[]      @relation("WalletExceptionOwner")
  claimedWalletExceptions      WalletExceptionCase[]      @relation("WalletExceptionClaimedBy")
  acknowledgedWalletExceptions WalletExceptionCase[]      @relation("WalletExceptionAcknowledgedBy")
  walletExceptionActions       WalletExceptionAction[]
  telegramBotConnections       TelegramBotConnection[]
  auditEvents                  EventAudit[]                @relation("OwnerAuditEvents")
}

model OwnerIdentityLink {
  id                String                    @id @default(cuid())
  ownerId           String
  provider          OwnerIdentityLinkProvider
  providerSubject   String
  email             String?
  phone             String?
  verifiedAt        DateTime?
  emailVerifiedAt   DateTime?
  phoneVerifiedAt   DateTime?
  metadata          Json?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  owner             Owner                     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([ownerId, provider])
}

model OwnerNotificationSettings {
  ownerId   String   @id
  rules     Json     @default("{}")
  version   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  owner     Owner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
}

model Wallet {
  id                String   @id @default(cuid())
  ownerId           String   @unique
  balanceCredits    Int      @default(0)
  sponsorPoolCredit Int      @default(0)
  starsBalance      Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  owner             Owner    @relation(fields: [ownerId], references: [id])
}

model AudienceIdentity {
  id                   String                      @id @default(cuid())
  audienceKey          String                      @unique
  status               AudienceIdentityStatus      @default(ANONYMOUS)
  mergedIntoId         String?
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  lastSeenAt           DateTime                    @default(now())
  mergedInto           AudienceIdentity?           @relation("AudienceIdentityMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom           AudienceIdentity[]          @relation("AudienceIdentityMerge")
  contacts             Contact[]
  conversations        Conversation[]
  userWallets          UserWallet[]
  sandboxIdentities    SandboxIdentity[]
  delegationTasks      DelegationTask[]
  memoryRecords        OpenVikingMemoryRecord[]
  identityLinks        IdentityLink[]
  bindingChallenges    IdentityBindingChallenge[]
  bridgeMappings       BridgeIdentityMapping[]
  entitlementAccounts  ServiceEntitlementAccount[]
  servicePaymentOrders ServicePaymentOrder[]
  tokenPurchases       AgentTokenPurchase[]
  usageCharges         AgentUsageCharge[]

  @@index([status, lastSeenAt])
  @@index([mergedIntoId])
}

model IdentityLink {
  id                 String                 @id @default(cuid())
  audienceIdentityId String
  provider           IdentityLinkProvider
  providerSubject    String
  issuer             String                 @default("delegate")
  connectionId       String?
  verifiedAt         DateTime?
  assuranceLevel     IdentityAssuranceLevel @default(UNVERIFIED)
  revokedAt          DateTime?
  proofMetadata      Json?
  metadata           Json?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  audienceIdentity   AudienceIdentity       @relation(fields: [audienceIdentityId], references: [id], onDelete: Cascade)
  connectionProofs   IdentityLinkConnectionProof[]

  @@unique([provider, providerSubject])
  @@index([audienceIdentityId, provider])
  @@index([provider, issuer, providerSubject])
  @@index([revokedAt])
}

model IdentityLinkConnectionProof {
  id             String                 @id @default(cuid())
  identityLinkId String
  issuer         String
  connectionId   String
  verifiedAt     DateTime?
  assuranceLevel IdentityAssuranceLevel @default(UNVERIFIED)
  revokedAt      DateTime?
  proofMetadata  Json?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  identityLink   IdentityLink           @relation(fields: [identityLinkId], references: [id], onDelete: Cascade)

  @@unique([identityLinkId, issuer, connectionId])
  @@index([issuer, connectionId, revokedAt])
}

model IdentityBindingChallenge {
  id                      String               @id @default(cuid())
  audienceIdentityId      String
  provider                IdentityLinkProvider
  issuer                  String               @default("delegate")
  connectionId            String
  expectedProviderSubject String?
  tokenHash               String               @unique
  expiresAt               DateTime
  consumedAt              DateTime?
  revokedAt               DateTime?
  metadata                Json?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  audienceIdentity        AudienceIdentity     @relation(fields: [audienceIdentityId], references: [id], onDelete: Cascade)

  @@index([audienceIdentityId, provider, createdAt])
  @@index([provider, issuer, connectionId, expiresAt])
  @@index([expiresAt, consumedAt, revokedAt])
}

model BridgeIdentityMapping {
  id                 String                @id @default(cuid())
  audienceIdentityId String?
  transport          ChannelTransport
  sourceProvider     ChannelSourceProvider
  connectionId       String
  transportSubject   String
  sourceSubject      String
  verifiedAt         DateTime?
  revokedAt          DateTime?
  metadata           Json?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  audienceIdentity   AudienceIdentity?     @relation(fields: [audienceIdentityId], references: [id], onDelete: SetNull)

  @@unique([connectionId, transport, transportSubject])
  @@unique([connectionId, sourceProvider, sourceSubject])
  @@index([audienceIdentityId, sourceProvider])
  @@index([revokedAt])
}

model UserWallet {
  id                 String               @id @default(cuid())
  audienceIdentityId String?
  externalUserId     String               @unique
  telegramUserId     String?              @unique
  email              String?              @unique
  displayName        String?
  currency           String               @default("CNY")
  cashBalanceCents   Int                  @default(0)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  audienceIdentity   AudienceIdentity?    @relation(fields: [audienceIdentityId], references: [id], onDelete: SetNull)
  ledgerEntries      WalletLedgerEntry[]
  rechargeOrders     RechargeOrder[]
  tokenPurchases     AgentTokenPurchase[]
  userAgentWallets   UserAgentWallet[]
  walletTransactions WalletTransaction[]

  @@index([currency, createdAt])
  @@index([audienceIdentityId, updatedAt])
}

model AgentWallet {
  id                     String               @id @default(cuid())
  representativeId       String               @unique
  currency               String               @default("CNY")
  tokenBalance           Int                  @default(0)
  totalPurchasedTokens   Int                  @default(0)
  totalConsumedTokens    Int                  @default(0)
  tokenUnitPriceCents    Int                  @default(1)
  creatorRevenueShareBps Int                  @default(2000)
