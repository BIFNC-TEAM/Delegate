  decisionNote             String?
  requestPayloadHash       String?
  matchedPolicyRuleId      String?
  representative           Representative                @relation(fields: [representativeId], references: [id])
  contact                  Contact?                      @relation(fields: [contactId], references: [id])
  conversation             Conversation?                 @relation(fields: [conversationId], references: [id])
  session                  ComputeSession?               @relation(fields: [sessionId], references: [id])
  generationRun            GenerationRun?                @relation(fields: [generationRunId], references: [id], onDelete: SetNull)
  delegationTask           DelegationTask?               @relation(fields: [delegationTaskId], references: [id], onDelete: SetNull)
  delegationTaskStep       DelegationTaskStep?           @relation(fields: [delegationTaskStepId], references: [id], onDelete: SetNull)
  workspaceSkillRelease    WorkspaceSkillRelease?        @relation(fields: [workspaceSkillReleaseId], references: [id], onDelete: SetNull)
