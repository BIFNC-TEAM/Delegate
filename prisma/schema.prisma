}

model MemoryChannelDisclosureDelivery {
  id                               String                                   @id @default(cuid())
  representativeId                 String
  contactId                        String
  conversationId                   String
  channelBindingId                 String
  bindingEpoch                     String
  sourceChannel                    RepresentativeChannelKind
  policyRevision                   Int
  disclosureContractVersion        String
  disclosureFingerprint            String
  disclosureHash                   String
  disclosureSnapshot               Json
  evidenceKind                     MemoryDisclosureEvidenceKind
  status                           MemoryDisclosureDeliveryStatus           @default(PENDING)
  representativeAssignmentRevision Int?
  connectionId                     String?
  externalMessageId                String?
  proofHash                        String?                                  @unique
  attemptCount                     Int                                      @default(0)
  availableAt                      DateTime                                 @default(now())
  leaseToken                       String?
  leaseExpiresAt                   DateTime?
  deliveredAt                      DateTime?
  /// Highest server receive sequence already present when delivery became
  /// durable. Authorization uses this floor, never provider timestamps.
  deliveredAfterIngressSequence    Int?
  lastErrorCode                    String?
  createdAt                        DateTime                                 @default(now())
  updatedAt                        DateTime                                 @updatedAt
  representative                   Representative                           @relation(fields: [representativeId], references: [id], onDelete: Cascade, map: "MemoryChannelDisclosureDelivery_rep_fkey")
  contact                          Contact                                  @relation(fields: [contactId, representativeId], references: [id, representativeId], onDelete: Cascade, map: "MemoryChannelDisclosureDelivery_contact_scope_fkey")
  conversation                     Conversation                             @relation(fields: [conversationId, representativeId, contactId], references: [id, representativeId, contactId], onDelete: Cascade, map: "MemoryChannelDisclosureDelivery_conversation_scope_fkey")
  channelBinding                   ConversationChannelBinding               @relation(fields: [channelBindingId], references: [id], onDelete: Cascade, map: "MemoryChannelDisclosureDelivery_binding_fkey")
  activation                       MemoryChannelDisclosureActivation?
  excludedInboundMessages          MemoryChannelDisclosureExcludedInbound[]

  @@unique([channelBindingId, policyRevision, disclosureContractVersion, bindingEpoch], map: "MemoryDisclosure_binding_policy_contract_epoch_key")
  @@unique([id, representativeId, contactId, sourceChannel], map: "MemoryChannelDisclosureDelivery_id_scope_key")
  @@index([representativeId, contactId, sourceChannel, status, deliveredAt], map: "MemoryChannelDisclosureDelivery_contact_channel_idx")
  @@index([conversationId, sourceChannel, status, deliveredAt], map: "MemoryChannelDisclosureDelivery_conversation_channel_idx")
  @@index([status, availableAt, leaseExpiresAt], map: "MemoryChannelDisclosureDelivery_due_idx")
}

/// Immutable provider IDs observed while a disclosure delivery was not yet
/// durable. These exact inbound events can never extract or recall memory,
/// even if concurrent ingestion assigns them a later server receive sequence.
model MemoryChannelDisclosureExcludedInbound {
  deliveryId               String
  externalInboundMessageId String
  createdAt                DateTime                        @default(now())
  delivery                 MemoryChannelDisclosureDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade, map: "MemoryDisclosureExcludedInbound_delivery_fkey")

  @@id([deliveryId, externalInboundMessageId], map: "MemoryDisclosureExcludedInbound_pkey")
  @@index([externalInboundMessageId], map: "MemoryDisclosureExcludedInbound_message_idx")
}

/// Immutable proof that identifies the first private-channel inbound message
/// observed after one delivered disclosure. That boundary message is always
/// excluded; only later server-ordered messages may extract or recall memory.
model MemoryChannelDisclosureActivation {
  deliveryId                   String                          @id
  firstExcludedMessageId       String                          @unique
  firstExcludedIngressSequence Int
  createdAt                    DateTime                        @default(now())
  delivery                     MemoryChannelDisclosureDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade, map: "MemoryDisclosureActivation_delivery_fkey")
  firstExcludedMessage         Message                         @relation("MemoryDisclosureActivationBoundary", fields: [firstExcludedMessageId], references: [id], onDelete: Cascade, map: "MemoryDisclosureActivation_message_fkey")

  @@index([firstExcludedIngressSequence], map: "MemoryDisclosureActivation_ingress_idx")
}

/// Immutable, bodyless proof of one exact contact-channel forget boundary.
/// Epoch fences queued work; the server ordinal proves which inputs predate it.
model ContactChannelMemoryForgetBoundary {
  id                         String                    @id @default(cuid())
  representativeId           String
  contactId                  String
  sourceChannel              RepresentativeChannelKind
  epoch                      Int
  sourceConversationId       String
  sourceMessageId            String                    @unique
  cutoffMemoryIngressOrdinal BigInt
  cutoffIngressSequence      Int?
  requestHash                String                    @unique
  createdAt                  DateTime                  @default(now())
  representative             Representative            @relation(fields: [representativeId], references: [id], onDelete: Restrict, map: "ContactMemoryForgetBoundary_rep_fkey")
  contact                    Contact                   @relation(fields: [contactId, representativeId], references: [id, representativeId], onDelete: Restrict, map: "ContactMemoryForgetBoundary_contact_scope_fkey")
  sourceMessage              Message                   @relation("ContactChannelMemoryForgetSourceMessage", fields: [sourceMessageId, sourceConversationId], references: [id, conversationId], onDelete: Restrict, map: "ContactMemoryForgetBoundary_message_scope_fkey")

  @@unique([representativeId, contactId, sourceChannel, epoch], map: "ContactMemoryForgetBoundary_scope_epoch_key")
  @@unique([sourceMessageId, sourceConversationId], map: "ContactMemoryForgetBoundary_message_scope_key")
  @@index([representativeId, contactId, sourceChannel, createdAt], map: "ContactMemoryForgetBoundary_scope_created_idx")
  @@index([sourceConversationId, cutoffIngressSequence], map: "ContactMemoryForgetBoundary_conversation_ingress_idx")
}

