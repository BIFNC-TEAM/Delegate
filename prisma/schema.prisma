model AgentUsageCharge {
  id                   String                     @id @default(cuid())
  userAgentWalletId    String?
  agentWalletId        String
  representativeId     String
  audienceIdentityId   String?
  entitlementAccountId String?
  conversationId       String?
  /// Database migrations enforce that wallet-entitlement binding coordinates
  /// are either all null (legacy/unbound) or all present, and that one
  /// GenerationRun owns at most one active bound reservation. Bound scope
  /// relations use RESTRICT deletion so the financial authorization remains
  /// independently verifiable.
  generationRunId      String?
  tokenPurchaseId      String?
  kind                 AgentUsageChargeKind
  status               AgentUsageChargeStatus     @default(CREATED)
  quantity             Int                        @default(1)
  tokenAmount          Int
  reservedTokenAmount  Int                        @default(0)
  settledTokenAmount   Int                        @default(0)
  releasedTokenAmount  Int                        @default(0)
