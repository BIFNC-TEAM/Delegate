model Owner {
  id                        String                     @id @default(cuid())
  organizationId            String?
  telegramUserId            String?                    @unique
  displayName               String
  handle                    String?
  timezone                  String                     @default("UTC")
  creatorVerificationStatus CreatorVerificationStatus  @default(UNVERIFIED)
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  wallet                    Wallet?
  organization              Organization?              @relation(fields: [organizationId], references: [id])
  organizationMember        OrganizationMember?
  capabilityProfiles        CapabilityPolicyProfile[]
  representatives           Representative[]
  creatorEarnings           CreatorEarning[]
  withdrawRequests          WithdrawRequest[]
  walletLedgerEntries       WalletLedgerEntry[]
  identityLinks             OwnerIdentityLink[]
  knowledgeAssets           KnowledgeAsset[]
  matrixVirtualUsers        MatrixVirtualUserBinding[]
}

model OwnerIdentityLink {
  id              String                    @id @default(cuid())
  ownerId         String
  provider        OwnerIdentityLinkProvider
  providerSubject String
  email           String?
  phone           String?
  verifiedAt      DateTime?
  metadata        Json?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  owner           Owner                     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([ownerId, provider])
}

model Wallet {
  id                String   @id @default(cuid())
  ownerId           String   @unique
  balanceCredits    Int      @default(0)
  sponsorPoolCredit Int      @default(0)
  starsBalance      Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  owner             Owner    @relation(fields: [ownerId], references: [id])
}

model AudienceIdentity {
  id                String                   @id @default(cuid())
  audienceKey       String                   @unique
  status            AudienceIdentityStatus   @default(ANONYMOUS)
  mergedIntoId      String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  lastSeenAt        DateTime                 @default(now())
  mergedInto        AudienceIdentity?        @relation("AudienceIdentityMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom        AudienceIdentity[]       @relation("AudienceIdentityMerge")
  contacts          Contact[]
  conversations     Conversation[]
  userWallets       UserWallet[]
  sandboxIdentities SandboxIdentity[]
  delegationTasks   DelegationTask[]
  memoryRecords     OpenVikingMemoryRecord[]
  identityLinks     IdentityLink[]

  @@index([status, lastSeenAt])
  @@index([mergedIntoId])
}

model IdentityLink {
  id                 String               @id @default(cuid())
  audienceIdentityId String
  provider           IdentityLinkProvider
  providerSubject    String
  verifiedAt         DateTime?
  metadata           Json?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  audienceIdentity   AudienceIdentity     @relation(fields: [audienceIdentityId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([audienceIdentityId, provider])
}

model UserWallet {
  id                 String               @id @default(cuid())
  audienceIdentityId String?
  externalUserId     String               @unique
  telegramUserId     String?              @unique
  email              String?              @unique
  displayName        String?
  currency           String               @default("CNY")
  cashBalanceCents   Int                  @default(0)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  audienceIdentity   AudienceIdentity?    @relation(fields: [audienceIdentityId], references: [id], onDelete: SetNull)
  ledgerEntries      WalletLedgerEntry[]
  rechargeOrders     RechargeOrder[]
  tokenPurchases     AgentTokenPurchase[]

  @@index([currency, createdAt])
  @@index([audienceIdentityId, updatedAt])
}

model AgentWallet {
  id                     String               @id @default(cuid())
  representativeId       String               @unique
  currency               String               @default("CNY")
  tokenBalance           Int                  @default(0)
  totalPurchasedTokens   Int                  @default(0)
  totalConsumedTokens    Int                  @default(0)
  tokenUnitPriceCents    Int                  @default(1)
  creatorRevenueShareBps Int                  @default(2000)
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  representative         Representative       @relation(fields: [representativeId], references: [id])
  ledgerEntries          WalletLedgerEntry[]
  tokenPurchases         AgentTokenPurchase[]
  usageCharges           AgentUsageCharge[]
  creatorEarnings        CreatorEarning[]

  @@index([currency, updatedAt])
}

model WalletLedgerEntry {
  id                     String                @id @default(cuid())
  eventGroupId           String
  idempotencyKey         String                @unique
  accountType            AmnWalletAccountType
  entryKind              AmnLedgerEntryKind
  userWalletId           String?
  agentWalletId          String?
  representativeId       String?
  ownerId                String?
  creatorEarningId       String?
  rechargeOrderId        String?
  paymentProviderEventId String?
  tokenPurchaseId        String?
  usageChargeId          String?
  withdrawRequestId      String?
  amountCents            Int                   @default(0)
  tokenAmount            Int                   @default(0)
  currency               String                @default("CNY")
  balanceAfterCents      Int?
  tokenBalanceAfter      Int?
  notes                  String?
  metadata               Json?
  createdAt              DateTime              @default(now())
  userWallet             UserWallet?           @relation(fields: [userWalletId], references: [id])
  agentWallet            AgentWallet?          @relation(fields: [agentWalletId], references: [id])
  representative         Representative?       @relation(fields: [representativeId], references: [id])
  owner                  Owner?                @relation(fields: [ownerId], references: [id])
  creatorEarning         CreatorEarning?       @relation(fields: [creatorEarningId], references: [id])
  rechargeOrder          RechargeOrder?        @relation(fields: [rechargeOrderId], references: [id])
  paymentProviderEvent   PaymentProviderEvent? @relation(fields: [paymentProviderEventId], references: [id])
  tokenPurchase          AgentTokenPurchase?   @relation(fields: [tokenPurchaseId], references: [id])
  usageCharge            AgentUsageCharge?     @relation(fields: [usageChargeId], references: [id])
  withdrawRequest        WithdrawRequest?      @relation(fields: [withdrawRequestId], references: [id])

  @@index([eventGroupId, createdAt])
  @@index([accountType, createdAt])
  @@index([entryKind, createdAt])
  @@index([userWalletId, createdAt])
  @@index([agentWalletId, createdAt])
  @@index([representativeId, createdAt])
  @@index([ownerId, createdAt])
}

model RechargeOrder {
  id              String                 @id @default(cuid())
  userWalletId    String
  provider        PaymentProvider        @default(MOCK)
  providerOrderId String?                @unique
  amountCents     Int
  currency        String                 @default("CNY")
  status          RechargeOrderStatus    @default(CREATED)
  idempotencyKey  String                 @unique
  checkoutUrl     String?
  providerPayload Json?
  paidAt          DateTime?
  refundedAt      DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  userWallet      UserWallet             @relation(fields: [userWalletId], references: [id])
  providerEvents  PaymentProviderEvent[]
  ledgerEntries   WalletLedgerEntry[]
  tokenPurchases  AgentTokenPurchase[]

  @@index([userWalletId, status, createdAt])
  @@index([provider, status, createdAt])
}

model PaymentProviderEvent {
  id                String                   @id @default(cuid())
  provider          PaymentProvider
  providerEventId   String
  eventType         PaymentProviderEventType @default(UNKNOWN)
  rechargeOrderId   String?
  rawPayload        Json
  normalizedPayload Json?
  receivedAt        DateTime                 @default(now())
  processedAt       DateTime?
  processingError   String?
  idempotencyKey    String?                  @unique
  rechargeOrder     RechargeOrder?           @relation(fields: [rechargeOrderId], references: [id])
  ledgerEntries     WalletLedgerEntry[]

  @@unique([provider, providerEventId])
  @@index([provider, eventType, receivedAt])
  @@index([rechargeOrderId, receivedAt])
}

model AgentTokenPurchase {
  id                     String                   @id @default(cuid())
  userWalletId           String
  agentWalletId          String
  representativeId       String
  rechargeOrderId        String?
  amountCents            Int
  currency               String                   @default("CNY")
  tokenAmount            Int
  tokenUnitPriceCents    Int
  creatorRevenueShareBps Int                      @default(2000)
  creatorPendingCents    Int
  status                 AgentTokenPurchaseStatus @default(COMPLETED)
  idempotencyKey         String                   @unique
  refundedAt             DateTime?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  userWallet             UserWallet               @relation(fields: [userWalletId], references: [id])
  agentWallet            AgentWallet              @relation(fields: [agentWalletId], references: [id])
  representative         Representative           @relation(fields: [representativeId], references: [id])
  rechargeOrder          RechargeOrder?           @relation(fields: [rechargeOrderId], references: [id])
  usageCharges           AgentUsageCharge[]
  creatorEarnings        CreatorEarning[]
  ledgerEntries          WalletLedgerEntry[]

  @@index([userWalletId, createdAt])
  @@index([agentWalletId, createdAt])
  @@index([representativeId, status, createdAt])
}

model AgentUsageCharge {
  id                   String                 @id @default(cuid())
  agentWalletId        String
  representativeId     String
  tokenPurchaseId      String?
  kind                 AgentUsageChargeKind
  status               AgentUsageChargeStatus @default(CREATED)
  quantity             Int                    @default(1)
  tokenAmount          Int
  providerCostCents    Int                    @default(0)
  platformRevenueCents Int                    @default(0)
  currency             String                 @default("CNY")
  idempotencyKey       String                 @unique
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  reversedAt           DateTime?
  agentWallet          AgentWallet            @relation(fields: [agentWalletId], references: [id])
  representative       Representative         @relation(fields: [representativeId], references: [id])
  tokenPurchase        AgentTokenPurchase?    @relation(fields: [tokenPurchaseId], references: [id])
  creatorEarnings      CreatorEarning[]
  ledgerEntries        WalletLedgerEntry[]

  @@index([agentWalletId, status, createdAt])
  @@index([representativeId, kind, createdAt])
}

model CreatorEarning {
  id                String               @id @default(cuid())
  ownerId           String
  representativeId  String
  agentWalletId     String
  tokenPurchaseId   String?
  usageChargeId     String?
  status            CreatorEarningStatus @default(PENDING)
  pendingCents      Int                  @default(0)
  withdrawableCents Int                  @default(0)
  frozenCents       Int                  @default(0)
  withdrawnCents    Int                  @default(0)
  currency          String               @default("CNY")
  revenueShareBps   Int                  @default(2000)
  idempotencyKey    String               @unique
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  owner             Owner                @relation(fields: [ownerId], references: [id])
  representative    Representative       @relation(fields: [representativeId], references: [id])
  agentWallet       AgentWallet          @relation(fields: [agentWalletId], references: [id])
  tokenPurchase     AgentTokenPurchase?  @relation(fields: [tokenPurchaseId], references: [id])
  usageCharge       AgentUsageCharge?    @relation(fields: [usageChargeId], references: [id])
  ledgerEntries     WalletLedgerEntry[]

  @@index([ownerId, status, createdAt])
  @@index([representativeId, status, createdAt])
  @@index([agentWalletId, status, createdAt])
}

model WithdrawRequest {
  id               String                @id @default(cuid())
  ownerId          String
  representativeId String?
  status           WithdrawRequestStatus @default(PENDING_REVIEW)
  amountCents      Int
  currency         String                @default("CNY")
  requestedAt      DateTime              @default(now())
  reviewedAt       DateTime?
  reviewedBy       String?
  paidAt           DateTime?
  provider         PaymentProvider?
  providerPayoutId String?               @unique
  failureReason    String?
  idempotencyKey   String                @unique
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  owner            Owner                 @relation(fields: [ownerId], references: [id])
  representative   Representative?       @relation(fields: [representativeId], references: [id])
  ledgerEntries    WalletLedgerEntry[]

  @@index([ownerId, status, requestedAt])
  @@index([representativeId, status, requestedAt])
}

model Organization {
  id                 String                    @id @default(cuid())
  slug               String                    @unique
  displayName        String
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  owners             Owner[]
  members            OrganizationMember[]
